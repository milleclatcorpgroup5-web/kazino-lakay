rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kazino Lakay pa li/ekri Firestore dirèkteman nan navigatè a.
    // Tout operasyon sou pwofil, balans, wonn ak tranzaksyon pase nan Worker la.
    // Worker la verifye Firebase ID token epi li sèvi ak service account IAM.
    // Règ sa yo bloke tout aksè dirèk nan Firebase Web SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
