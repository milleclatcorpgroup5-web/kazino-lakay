rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kazino Lakay ekri/li done finansye yo sèlman nan Cloudflare Worker la.
    // Worker la otantifye itilizatè a epi sèvi ak Service Account + IAM.
    // Pa bay navigatè jwè yo aksè dirèk ak balans, ledger oswa paramèt sistèm.
    match /users/{uid} { allow read, write: if false; }
    match /walletAccounts/{uid} { allow read, write: if false; }
    match /walletTransactions/{transactionId} { allow read, write: if false; }
    match /platformWallet/{accountId} { allow read, write: if false; }
    match /gameRounds/{roundId} { allow read, write: if false; }
    match /adminActions/{actionId} { allow read, write: if false; }
    match /systemSettings/{settingId} { allow read, write: if false; }
    // Tout lòt koleksyon rete fèmen tou.
    match /{document=**} { allow read, write: if false; }
  }
}
